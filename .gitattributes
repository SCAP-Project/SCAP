# Normaliza arquivos de texto
* text=auto

# Código e configuração usam LF
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ipynb text eol=lf
*.csv text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Scripts Windows mantêm CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binários (nunca normalizar)
*.pdf binary
*.docx binary
*.ppt binary
*.pptx binary
*.xlsx binary
*.pbix binary
*.png binary
*.jpg binary
*.pem binary
